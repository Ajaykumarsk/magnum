# backend/.env
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-django-insecure-abc123xyz
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.29.63

# Database
DB_NAME=magnum_db
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432

# Redis (for WebSockets)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://192.168.29.63:4200

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Environment
DJANGO_SETTINGS_MODULE=config.settings.development